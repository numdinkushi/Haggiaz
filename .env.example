# Required for deployment (mainnet or testnet)
PRIVATE_KEY=0x_your_private_key_here

# Optional: RPC URLs (defaults used if not set)
# CELO_MAINNET_RPC_URL=https://forno.celo.org
# CELO_TESTNET_RPC_URL=https://alfajores-forno.celo-testnet.org

# Token addresses (optional - defaults from Celo docs)
# Alfajores USDm: https://docs.celo.org/token-addresses
# USDM_ALFAJORES=0xdE9e4C3ce781b4bA68120d6261cbad65ce0aB00b
# Mainnet USDm
# USDM_MAINNET=0x765DE816845861e75A25fCA122bb6898B8B1282a
