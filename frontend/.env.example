# WalletConnect Cloud project ID (for RainbowKit)
# Get one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Convex - Cloud URL from your Convex dashboard
NEXT_PUBLIC_CONVEX_URL=

# Use Celo testnet (Alfajores) for free testing — set to true, deploy contracts to testnet, then add celoTestnet addresses in ../addresses.json
# Faucet: https://faucet.celo.org
NEXT_PUBLIC_USE_TESTNET=
